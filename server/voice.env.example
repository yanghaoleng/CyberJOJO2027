VOLC_SPEECH_API_KEY=
# Legacy speech-console credentials can be used instead of VOLC_SPEECH_API_KEY:
# VOLC_SPEECH_APP_ID=
# VOLC_SPEECH_ACCESS_TOKEN=
VOLC_SPEECH_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# Optional comma-separated additions. The built-in brand lexicon is always included.
# JOCAM_ASR_HOTWORDS=阅读星球,叫叫阅读

# TTS reuses VOLC_SPEECH_API_KEY by default. Override only when using a separate key.
# VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
JOCAM_TTS_JIAOJIAO_VOICE=zh_female_xueayi_saturn_bigtts
JOCAM_TTS_LVDOU_VOICE=zh_male_dayi_saturn_bigtts

VOLC_ARK_API_KEY=
VOLC_ARK_MODEL=doubao-seed-2-0-lite-260215
VOLC_ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses

PORT=8787
JOCAM_ALLOWED_ORIGINS=https://cyberjojo.mikeywa.site,https://mikeywa.site,https://www.mikeywa.site,https://rive.mikeywa.site
JOCAM_MAX_SESSION_MS=300000
JOCAM_MAX_CONNECTIONS_PER_IP=2
