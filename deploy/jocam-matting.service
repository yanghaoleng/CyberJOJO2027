[Unit]
Description=JOCAM memory-only sticker matting
After=network.target

[Service]
User=jocam-voice
Group=jocam-voice
ExecStart=/opt/jocam-matting/venv/bin/python /opt/jocam-matting/current/matting_worker.py
Environment=OMP_NUM_THREADS=1
Restart=on-failure
RestartSec=3
MemoryMax=900M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
